@inject IJSRuntime JS

@if (showSettings)
{
    <ProjectSettings Project="@Project"
                     OnBack="CloseSettings" />
}
else
{
    <section class="novel-editor @(isSceneListVisible ? "" : "scenes-collapsed")">
        <header class="editor-header">
            <button class="editor-button"
                    disabled="@isSaving"
                    @onclick="HandleBack">
                Назад
            </button>

            <h1 class="editor-title" title="@Project.Title">
                @Project.Title
            </h1>

            <button class="editor-button settings-button"
                    disabled="@isSaving"
                    title="Настройки проекта"
                    aria-label="Настройки проекта"
                    @onclick="OpenSettings">
                <span aria-hidden="true">⚙</span>
            </button>

            <button class="editor-button"
                    disabled="@isSaving"
                    @onclick="SaveProject">
                @(isSaving ? "Сохраняем…" : "Сохранить")
            </button>
        </header>

        <div class="scene-preview visual-preview"
             aria-label="Предпросмотр сцены">

            <ProjectImage Project="@Project"
                          AssetPath="@PreviewBackgroundPath"
                          CssClass="preview-background"
                          Alt="Фон сцены" />

            <ProjectImage Project="@Project"
                          AssetPath="@PreviewCharacterPath"
                          CssClass="@($"preview-character is-{PreviewCharacterSide}")"
                          Alt="@GetAssetName(PreviewCharacterPath)" />

            <span class="preview-label">Предпросмотр</span>

            <div class="preview-dialogue">
                <h2>
                    @if (!string.IsNullOrWhiteSpace(PreviewHeading))
                    {
                        <h2>@PreviewHeading</h2>
                    }
                </h2>

                <p>
                    @(string.IsNullOrWhiteSpace(PreviewText)
                        ? "Здесь появится текст выбранной сцены."
                        : PreviewText)
                </p>
            </div>
        </div>

        <div class="scene-list-toolbar">
            <h2 class="scene-list-heading">
                @(editingScene is null
                    ? "Список сцен"
                    : "Настройки: " + editingScene.Name)
            </h2>

            <button class="scene-edit-button"
                    title="@SceneListToggleLabel"
                    aria-label="@SceneListToggleLabel"
                    aria-expanded="@(isSceneListVisible ? "true" : "false")"
                    aria-controls="scene-list"
                    @onclick="ToggleSceneList">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M2 12C4.5 7 8 5 12 5s7.5 2 10 7c-2.5 5-6 7-10 7S4.5 17 2 12Z" />
                    <circle cx="12" cy="12" r="3" />

                    @if (!isSceneListVisible)
                    {
                        <path d="M3 3L21 21" />
                    }
                </svg>
            </button>
        </div>

        <div id="scene-list"
             class="scene-list @(editingScene is null ? "" : "scene-settings-panel")"
             hidden="@(!isSceneListVisible)">

            @if (editingScene is null)
            {
                @foreach (var scene in scenes)
                {
                    <div @key="scene"
                         class="scene-row @(selectedScene == scene ? "is-selected" : "")">
                        <button class="scene-select"
                                aria-pressed="@(selectedScene == scene)"
                                @onclick="() => SelectScene(scene)">
                            @scene.Name
                        </button>

                        <button class="scene-edit-button"
                                title="Скопировать сцену"
                                aria-label="@($"Скопировать сцену: {scene.Name}")"
                                @onclick="() => CopyScene(scene)">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="8" y="8" width="12" height="12" rx="2" />
                                <path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" />
                            </svg>
                        </button>

                        <button class="scene-edit-button"
                                title="Изменить сцену"
                                aria-label="@($"Редактировать сцену: {scene.Name}")"
                                @onclick="() => EditScene(scene)">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M16 3 L21 8 L9 20 L4 20 L4 15 Z M14 5 L19 10" />
                            </svg>
                        </button>

                        <button class="scene-edit-button scene-delete-button"
                                title="Удалить сцену"
                                aria-label="@($"Удалить сцену: {scene.Name}")"
                                disabled="@(scenes.Count <= 1 || isSaving || isDeletingScene)"
                                @onclick="() => DeleteScene(scene)">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M3 6h18M9 6V4h6v2M5 6l1 14h12l1-14M10 10v6M14 10v6" />
                            </svg>
                        </button>
                    </div>
                }
            }
            else
            {
                <form id="scene-settings-form"
                      class="project-form"
                      @onsubmit="ApplyChanges"
                      @onsubmit:preventDefault>

                    <label for="scene-background">Фон</label>

                    <select id="scene-background"
                            class="project-input"
                            @bind="draftBackgroundPath">
                        <option value="">Без фона</option>

                        @foreach (var path in BackgroundPaths)
                        {
                            <option value="@path">
                                @GetAssetName(path)
                            </option>
                        }
                    </select>

                    <label for="scene-character">Персонаж</label>

                    <select id="scene-character"
                            class="project-input"
                            @bind="draftCharacterPath">
                        <option value="">Без персонажа</option>

                        @foreach (var path in CharacterPaths)
                        {
                            <option value="@path">
                                @GetAssetName(path)
                            </option>
                        }
                    </select>

                    <fieldset class="character-position"
                              disabled="@string.IsNullOrEmpty(draftCharacterPath)">
                        <legend>Положение персонажа</legend>

                        <div class="position-options">
                            <label class="position-option">
                                <input type="radio"
                                       name="character-side"
                                       value="left"
                                       checked="@(draftCharacterSide == "left")"
                                       @onchange="PositionLeft" />
                                <span>Слева</span>
                            </label>

                            <label class="position-option">
                                <input type="radio"
                                       name="character-side"
                                       value="right"
                                       checked="@(draftCharacterSide == "right")"
                                       @onchange="PositionRight" />
                                <span>Справа</span>
                            </label>
                        </div>
                    </fieldset>

                    <label for="scene-heading">Заголовок</label>

                    <input id="scene-heading"
                           class="project-input"
                           @bind="draftHeading"
                           @bind:event="oninput"
                           maxlength="80" />

                    <label for="scene-text">Текст</label>

                    <textarea id="scene-text"
                              class="project-input"
                              @bind="draftText"
                              @bind:event="oninput"
                              rows="5"></textarea>

                    <label for="scene-music">Музыка</label>

                    <select id="scene-music"
                            class="project-input"
                            @bind="draftMusicPath">
                        <option value="">Без музыки</option>

                        @foreach (var path in MusicPaths)
                        {
                            <option value="@path">
                                @GetAssetName(path)
                            </option>
                        }
                    </select>

                    @if (errorMessage is not null)
                    {
                        <p class="scene-form-error" role="alert">
                            @errorMessage
                        </p>
                    }

                    <button type="button"
                            class="menu-back"
                            @onclick="CancelEdit">
                        Отмена
                    </button>
                </form>
            }
        </div>

        <footer class="editor-footer"
                hidden="@(!isSceneListVisible && fileMessage is null)">
            @if (fileMessage is not null)
            {
                <p class="editor-file-message" role="status">
                    @fileMessage
                </p>
            }

            @if (isSceneListVisible)
            {
                @if (editingScene is null)
                {
                    <button class="scene-add-button"
                            aria-label="Добавить сцену"
                            @onclick="AddScene">
                        +
                    </button>
                }
                else
                {
                    <button type="submit"
                            form="scene-settings-form"
                            class="project-submit scene-save-button">
                        Сохранить сцену
                    </button>
                }
            }
        </footer>
    </section>
}

@code {
    [Parameter, EditorRequired]
    public NovelProject Project { get; set; } = default!;

    [Parameter]
    public EventCallback OnBack { get; set; }

    private List<NovelScene> scenes => Project.Scenes;

    private NovelScene selectedScene = default!;
    private NovelScene? editingScene;

    private bool showSettings;
    private bool isSaving;
    private bool isSceneListVisible = true;

    private string? fileMessage;
    private string? errorMessage;

    private string draftHeading = string.Empty;
    private string draftText = string.Empty;
    private string draftBackgroundPath = string.Empty;
    private string draftCharacterPath = string.Empty;
    private string draftCharacterSide = "left";

    private string PreviewHeading =>
    editingScene is null
        ? selectedScene.Heading
        : draftHeading;

    private string PreviewText =>
        editingScene is null ? selectedScene.Text : draftText;

    private string? PreviewBackgroundPath =>
        editingScene is null
            ? selectedScene.BackgroundPath
            : draftBackgroundPath;

    private string? PreviewCharacterPath =>
        editingScene is null
            ? selectedScene.CharacterPath
            : draftCharacterPath;

    private string PreviewCharacterSide =>
        editingScene is null
            ? selectedScene.CharacterSide
            : draftCharacterSide;

    private string SceneListToggleLabel =>
        isSceneListVisible
            ? "Скрыть нижнюю панель"
            : "Показать нижнюю панель";

    private IEnumerable<string> BackgroundPaths =>
        GetResourcePaths("backgrounds");

    private IEnumerable<string> CharacterPaths =>
        GetResourcePaths("characters");

    protected override void OnInitialized()
    {
        for (var i = 0; i < scenes.Count; i++)
        {
            var scene = scenes[i];

            var hasNumberedName =
                System.Text.RegularExpressions.Regex.IsMatch(
                    scene.Name,
                    @"^Сцена \d+$");

            if (string.IsNullOrWhiteSpace(scene.Heading)
                && !hasNumberedName)
            {
                scene.Heading = scene.Name;
            }

            scene.Name = $"Сцена {i + 1}";
        }

        selectedScene = scenes[0];
    }

    private IEnumerable<string> GetResourcePaths(string folder)
    {
        return Project.Assets.Keys
            .Where(path => path.StartsWith(
                $"assets/{folder}/",
                StringComparison.Ordinal))
            .OrderBy(GetAssetName, StringComparer.OrdinalIgnoreCase);
    }

    private string GetAssetName(string? path)
    {
        if (string.IsNullOrEmpty(path))
        {
            return "Персонаж";
        }

        return Project.AssetNames.TryGetValue(path, out var name)
            ? name
            : Path.GetFileNameWithoutExtension(path);
    }

    private void SelectScene(NovelScene scene)
    {
        selectedScene = scene;
    }

    private void AddScene()
    {
        var scene = new NovelScene
        {
            Name = $"Сцена {scenes.Count + 1}"
        };

        scenes.Add(scene);
        selectedScene = scene;
        fileMessage = null;
    }

    private void EditScene(NovelScene scene)
    {
        selectedScene = scene;
        editingScene = scene;

        draftHeading = scene.Heading;
        draftText = scene.Text;
        draftBackgroundPath = scene.BackgroundPath ?? string.Empty;
        draftCharacterPath = scene.CharacterPath ?? string.Empty;
        draftCharacterSide = scene.CharacterSide;
        draftMusicPath = scene.MusicPath ?? string.Empty;

        errorMessage = null;
        fileMessage = null;
        isSceneListVisible = true;
    }

    private void PositionLeft()
    {
        draftCharacterSide = "left";
    }

    private void PositionRight()
    {
        draftCharacterSide = "right";
    }

    private void ApplyChanges()
    {
        TryApplySceneChanges();
    }

    private bool TryApplySceneChanges()
    {
        if (editingScene is null)
        {
            return true;
        }

        var heading = draftHeading.Trim();

        if (heading.Length > 80)
        {
            errorMessage = "Заголовок должен быть не длиннее 80 символов.";
            isSceneListVisible = true;
            return false;
        }

        editingScene.Heading = heading;
        editingScene.Text = draftText;

        editingScene.BackgroundPath =
            string.IsNullOrEmpty(draftBackgroundPath)
                ? null
                : draftBackgroundPath;

        editingScene.CharacterPath =
            string.IsNullOrEmpty(draftCharacterPath)
                ? null
                : draftCharacterPath;

        editingScene.CharacterSide = draftCharacterSide;

        editingScene.MusicPath =
            string.IsNullOrEmpty(draftMusicPath)
                ? null
                : draftMusicPath;

        selectedScene = editingScene;
        editingScene = null;

        errorMessage = null;
        fileMessage = null;
        isSceneListVisible = true;

        return true;
    }

    private void CancelEdit()
    {
        editingScene = null;
        errorMessage = null;
        fileMessage = null;
        isSceneListVisible = true;
    }

    private async Task HandleBack()
    {
        if (editingScene is not null)
        {
            CancelEdit();
            return;
        }

        await OnBack.InvokeAsync();
    }

    private void OpenSettings()
    {
        showSettings = true;
    }

    private void CloseSettings()
    {
        showSettings = false;
        fileMessage = null;
    }

    private void ToggleSceneList()
    {
        isSceneListVisible = !isSceneListVisible;
    }

    private async Task SaveProject()
    {
        if (isSaving || !TryApplySceneChanges())
        {
            return;
        }

        isSaving = true;
        fileMessage = null;

        try
        {
            Project.ReadingProgress = null;

            using var stream =
                await ProjectArchive.CreateAsync(Project);

            using var reference = new DotNetStreamReference(
                stream, leaveOpen: true);

            await JS.InvokeVoidAsync(
                "novelFiles.download",
                Project.Title,
                reference);

            fileMessage = "Файл передан браузеру для сохранения.";
        }
        catch (InvalidDataException exception)
        {
            fileMessage = exception.Message;
        }
        catch (JSException)
        {
            fileMessage =
                "Не удалось начать скачивание. Попробуй ещё раз.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void CopyScene(NovelScene source)
    {
        var sourceIndex = scenes.IndexOf(source);

        if (sourceIndex < 0)
        {
            return;
        }

        var copy = new NovelScene
        {
            Heading = source.Heading,
            Text = source.Text,
            BackgroundPath = source.BackgroundPath,
            CharacterPath = source.CharacterPath,
            CharacterSide = source.CharacterSide,
            MusicPath = source.MusicPath,
        };

        scenes.Insert(sourceIndex + 1, copy);

        for (var i = 0; i < scenes.Count; i++)
        {
            scenes[i].Name = $"Сцена {i + 1}";
        }

        selectedScene = copy;
        fileMessage = null;
        errorMessage = null;
    }

    private bool isDeletingScene;

    private async Task DeleteScene(NovelScene scene)
    {
        if (scenes.Count <= 1 || isSaving || isDeletingScene)
        {
            return;
        }

        isDeletingScene = true;

        try
        {
            var confirmed = await JS.InvokeAsync<bool>(
                "confirm",
                $"Удалить «{scene.Name}»?");

            if (!confirmed)
            {
                return;
            }

            var index = scenes.IndexOf(scene);

            if (index < 0 || scenes.Count <= 1)
            {
                return;
            }

            scenes.RemoveAt(index);

            if (selectedScene == scene)
            {
                selectedScene = scenes[Math.Min(index, scenes.Count - 1)];
            }

            for (var i = 0; i < scenes.Count; i++)
            {
                scenes[i].Name = $"Сцена {i + 1}";
            }

            fileMessage = null;
            errorMessage = null;
        }
        catch (JSException)
        {
            fileMessage =
                "Не удалось открыть подтверждение. Сцена не удалена.";
        }
        finally
        {
            isDeletingScene = false;
        }
    }

    private string draftMusicPath = string.Empty;

    private IEnumerable<string> MusicPaths =>
        GetResourcePaths("music");
}